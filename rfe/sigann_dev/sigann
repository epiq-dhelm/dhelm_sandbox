#!/usr/bin/python3
"""Tk spectrum display for an RF Explorer signal analyzer."""

from __future__ import annotations

import logging
import signal
import sys
import tkinter as tk
from tkinter import messagebox, simpledialog, ttk

import matplotlib.pyplot as plt
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg

from sigann_core import (
    AnalyzerController,
    AnalyzerSettings,
    ConnectionState,
    ControllerEvent,
    EventKind,
    MAX_MARKERS,
    Sweep,
)
from sigann_rfexplorer import RFExplorerDevice


LOG = logging.getLogger("sigann")
POLL_INTERVAL_MS = 100
RECONNECT_INTERVAL_MS = 1000
SWEEP_TIMEOUT_SECONDS = 3.0


class SigannApp:
    """Own the Tk interface and translate controller events into UI updates."""

    def __init__(self, root: tk.Tk, controller: AnalyzerController):
        self.root = root
        self.controller = controller
        self.settings = AnalyzerSettings()
        self.limits = None
        self._closing = False
        self._poll_id = None
        self._retry_id = None
        self._annotations = []
        self._last_sweep = None
        self._marker_window = None
        self._marker_count_var = None
        self._marker_table = None
        self.rbw_khz = None

        self.root.title("RFE Signal Analyzer")
        self.root.geometry("800x720+100+200")
        self.root.protocol("WM_DELETE_WINDOW", self.close)
        self.root.columnconfigure(0, weight=1)
        self.root.rowconfigure(0, weight=1)

        self._build_ui()

    def _build_ui(self) -> None:
        content = ttk.Frame(self.root, padding=(8, 8, 8, 8))
        content.grid(row=0, column=0, sticky="nsew")
        content.columnconfigure(0, weight=1)
        content.rowconfigure(0, weight=1)

        plot_frame = ttk.Frame(content, relief="ridge", borderwidth=2)
        plot_frame.grid(row=0, column=0, sticky="nsew")
        plot_frame.columnconfigure(0, weight=1)
        plot_frame.rowconfigure(0, weight=1)

        self.figure = plt.Figure()
        self.axes = self.figure.add_subplot(111)
        self.axes.grid(which="major", linewidth=1)
        self.axes.grid(which="minor", linewidth=0.2)
        self.axes.minorticks_on()
        self.axes.set_xlabel("Frequency (MHz)")
        self.axes.set_ylabel("Amplitude (dBm)")
        self.axes.set_ylim(-110, 0)
        self.line, = self.axes.plot([], [])

        self.canvas = FigureCanvasTkAgg(self.figure, master=plot_frame)
        self.canvas.get_tk_widget().grid(row=0, column=0, sticky="nsew")

        controls = ttk.Frame(content, padding=(8, 0, 0, 0))
        controls.grid(row=0, column=1, sticky="nsew")
        controls.columnconfigure(0, weight=1)
        for row in range(3):
            controls.rowconfigure(row, weight=1)

        self.frequency_button = ttk.Button(
            controls,
            text="Frequency",
            command=self.change_frequency,
        )
        self.frequency_button.grid(row=0, column=0, sticky="nsew", pady=(0, 4))
        self.span_button = ttk.Button(
            controls,
            text="Span",
            command=self.change_span,
        )
        self.span_button.grid(row=1, column=0, sticky="nsew", pady=4)
        self.marker_button = ttk.Button(
            controls,
            text="Marker",
            command=self.change_markers,
        )
        self.marker_button.grid(row=2, column=0, sticky="nsew", pady=(4, 0))
        self._set_controls_enabled(False)

        self.info_var = tk.StringVar(value=self._settings_text())
        ttk.Label(
            content,
            textvariable=self.info_var,
            anchor="center",
            justify="center",
            relief="ridge",
            padding=(8, 6),
            font=("Arial", 12, "bold"),
        ).grid(row=1, column=0, columnspan=2, sticky="ew", pady=(8, 0))

        self.status_var = tk.StringVar(value="Starting...")
        ttk.Label(
            content,
            textvariable=self.status_var,
            anchor="w",
        ).grid(row=2, column=0, columnspan=2, sticky="ew", pady=(4, 0))

    def start(self) -> None:
        self._begin_connect("Connecting to RF Explorer analyzer...")
        self._schedule_poll()

    def run(self) -> None:
        self.start()
        self.root.mainloop()

    def _schedule_poll(self) -> None:
        if not self._closing:
            self._poll_id = self.root.after(POLL_INTERVAL_MS, self._poll)

    def _poll(self) -> None:
        self._poll_id = None
        if self._closing:
            return

        for event in self.controller.drain_events():
            self._handle_event(event)

        if self.controller.state == ConnectionState.STREAMING:
            try:
                sweep = self.controller.read_sweep()
                if sweep is not None:
                    self._display_sweep(sweep)
                problem = self.controller.connection_problem(SWEEP_TIMEOUT_SECONDS)
                if problem is not None:
                    self._begin_connect(f"Connection lost: {problem}; reconnecting...")
            except Exception as error:
                LOG.exception("Error while reading analyzer sweep")
                self._begin_connect(f"Read failed: {error}; reconnecting...")

        self._schedule_poll()

    def _handle_event(self, event: ControllerEvent) -> None:
        LOG.info(event.message)
        if event.kind in {EventKind.CONNECTED, EventKind.RECONFIGURED}:
            self.limits = event.limits
            self.status_var.set(event.message)
            self._set_controls_enabled(True)
            if event.port:
                self.root.title(f"RFE Signal Analyzer — {event.port}")
            if event.sweep is not None:
                self._display_sweep(event.sweep)
            self.info_var.set(self._settings_text())
            return

        if event.kind == EventKind.FAILED:
            self.status_var.set(f"{event.message}. Retrying...")
            self.root.title("RFE Signal Analyzer — disconnected")
            self._set_controls_enabled(False)
            self._schedule_retry()

    def _begin_connect(self, status: str) -> None:
        if self._closing:
            return
        if self._retry_id is not None:
            self.root.after_cancel(self._retry_id)
            self._retry_id = None
        if self.controller.connect(self.settings, reason=status.rstrip(".")):
            self.status_var.set(status)
            self._set_controls_enabled(False)

    def _schedule_retry(self) -> None:
        if self._closing or self._retry_id is not None:
            return
        self._retry_id = self.root.after(RECONNECT_INTERVAL_MS, self._retry_connect)

    def _retry_connect(self) -> None:
        self._retry_id = None
        self._begin_connect("Waiting for RF Explorer analyzer...")

    def _set_controls_enabled(self, enabled: bool) -> None:
        state = "normal" if enabled else "disabled"
        self.frequency_button.configure(state=state)
        self.span_button.configure(state=state)
        self.marker_button.configure(state=state)

    def change_frequency(self) -> None:
        value = simpledialog.askstring(
            "Frequency",
            "Center frequency (MHz):",
            initialvalue=f"{self.settings.center_mhz:g}",
            parent=self.root,
        )
        if value is None:
            return
        try:
            self._apply_settings(self.settings.with_center(value))
        except ValueError as error:
            messagebox.showerror("Invalid frequency", str(error), parent=self.root)

    def change_span(self) -> None:
        value = simpledialog.askstring(
            "Span",
            "Span (MHz):",
            initialvalue=f"{self.settings.span_mhz:g}",
            parent=self.root,
        )
        if value is None:
            return
        try:
            self._apply_settings(self.settings.with_span(value))
        except ValueError as error:
            messagebox.showerror("Invalid span", str(error), parent=self.root)

    def change_markers(self) -> None:
        if self._marker_window is not None and self._marker_window.winfo_exists():
            self._marker_window.lift()
            self._marker_window.focus_force()
            return

        window = tk.Toplevel(self.root)
        window.title("Markers")
        window.transient(self.root)
        window.protocol("WM_DELETE_WINDOW", self._close_marker_window)
        window.columnconfigure(0, weight=1)
        self._marker_window = window

        selector = ttk.Frame(window, padding=8)
        selector.grid(row=0, column=0, sticky="ew")
        selector.columnconfigure(1, weight=1)
        ttk.Label(selector, text=f"Number of markers (0–{MAX_MARKERS}):").grid(
            row=0, column=0, sticky="w", padx=(0, 8)
        )
        self._marker_count_var = tk.StringVar(value=str(self.settings.marker_count))
        marker_entry = ttk.Spinbox(
            selector,
            from_=0,
            to=MAX_MARKERS,
            width=4,
            textvariable=self._marker_count_var,
            command=self._apply_marker_count,
        )
        marker_entry.grid(row=0, column=1, sticky="w")
        marker_entry.bind("<Return>", self._apply_marker_count)
        ttk.Button(
            selector,
            text="Apply",
            command=self._apply_marker_count,
        ).grid(row=0, column=2, padx=(8, 0))

        self._marker_table = ttk.Treeview(
            window,
            columns=("marker", "frequency", "amplitude"),
            show="headings",
            height=MAX_MARKERS,
        )
        self._marker_table.heading("marker", text="Marker #")
        self._marker_table.heading("frequency", text="Frequency (MHz)")
        self._marker_table.heading("amplitude", text="Amplitude (dBm)")
        self._marker_table.column("marker", width=80, anchor="center")
        self._marker_table.column("frequency", width=160, anchor="e")
        self._marker_table.column("amplitude", width=160, anchor="e")
        self._marker_table.grid(row=1, column=0, sticky="nsew", padx=8, pady=(0, 8))
        marker_entry.focus_set()
        marker_entry.selection_range(0, tk.END)
        self._update_marker_table()

    def _apply_marker_count(self, _event=None) -> None:
        if self._marker_count_var is None:
            return
        try:
            settings = self.settings.with_marker_count(self._marker_count_var.get())
            settings.validate(self.limits)
        except ValueError as error:
            messagebox.showerror("Invalid marker count", str(error), parent=self.root)
            return
        self.settings = settings
        self.info_var.set(self._settings_text())
        if self._last_sweep is not None:
            self._draw_markers(self._last_sweep)
            self.canvas.draw_idle()

    def _close_marker_window(self) -> None:
        if self._marker_window is not None:
            self._marker_window.destroy()
        self._marker_window = None
        self._marker_count_var = None
        self._marker_table = None

    def _apply_settings(self, settings: AnalyzerSettings) -> None:
        settings.validate(self.limits)
        if not self.controller.reconfigure(settings):
            raise ValueError("Analyzer is not ready for configuration")
        self.settings = settings
        self.status_var.set("Updating analyzer configuration...")
        self._set_controls_enabled(False)

    def _display_sweep(self, sweep: Sweep) -> None:
        self._last_sweep = sweep
        if sweep.rbw_khz is not None:
            self.rbw_khz = sweep.rbw_khz
            self.info_var.set(self._settings_text())
        self.line.set_xdata(sweep.frequencies_mhz)
        self.line.set_ydata(sweep.amplitudes_dbm)
        self.axes.set_xlim(self.settings.start_mhz, self.settings.stop_mhz)
        self._draw_markers(sweep)
        self.canvas.draw_idle()

    def _draw_markers(self, sweep: Sweep) -> None:
        for annotation in self._annotations:
            annotation.remove()
        self._annotations.clear()

        ranked = sorted(
            zip(sweep.amplitudes_dbm, sweep.frequencies_mhz),
            reverse=True,
        )
        self._update_marker_table(ranked)
        count = self.settings.marker_count or 1
        for index, (amplitude, frequency) in enumerate(ranked[:count]):
            label = (
                f"{frequency:.3f} MHz\n{amplitude:.1f} dBm"
                if self.settings.marker_count == 0
                else f"M{index}: {frequency:.3f} MHz, {amplitude:.1f} dBm"
            )
            annotation = self.axes.annotate(
                label,
                xy=(frequency, amplitude),
                textcoords="offset pixels",
                xytext=(15, 20 + index * 12),
                arrowprops={"arrowstyle": "->", "facecolor": "black"},
                fontsize=9,
            )
            self._annotations.append(annotation)

    def _update_marker_table(self, ranked=None) -> None:
        if self._marker_table is None or not self._marker_table.winfo_exists():
            return
        for item in self._marker_table.get_children():
            self._marker_table.delete(item)
        if self._last_sweep is None or self.settings.marker_count == 0:
            return
        if ranked is None:
            ranked = sorted(
                zip(
                    self._last_sweep.amplitudes_dbm,
                    self._last_sweep.frequencies_mhz,
                ),
                reverse=True,
            )
        for index, (amplitude, frequency) in enumerate(
            ranked[:self.settings.marker_count]
        ):
            self._marker_table.insert(
                "",
                "end",
                values=(index, f"{frequency:.3f}", f"{amplitude:.2f}"),
            )

    def _settings_text(self) -> str:
        rbw = f"{self.rbw_khz:.1f} kHz" if self.rbw_khz is not None else "-- kHz"
        return (
            f"Start: {self.settings.start_mhz:.3f} MHz    "
            f"Center: {self.settings.center_mhz:.3f} MHz    "
            f"Stop: {self.settings.stop_mhz:.3f} MHz\n"
            f"RBW: {rbw}                         "
            f"Span: {self.settings.span_mhz:.3f} MHz"
        )

    def close(self) -> None:
        if self._closing:
            return
        self._closing = True
        self.status_var.set("Closing...")
        if self._poll_id is not None:
            self.root.after_cancel(self._poll_id)
            self._poll_id = None
        if self._retry_id is not None:
            self.root.after_cancel(self._retry_id)
            self._retry_id = None
        self._close_marker_window()
        self.controller.shutdown()
        self.root.destroy()


def configure_logging() -> None:
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(name)s: %(message)s",
    )


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "--check-runtime":
        tk.Tcl().eval("info patchlevel")
        RFExplorerDevice.candidate_ports()
        print("sigann runtime imports OK")
        return 0
    if len(sys.argv) == 2 and sys.argv[1] == "--check-gui":
        root = tk.Tk(className="annName")
        root.withdraw()
        SigannApp(root, AnalyzerController(RFExplorerDevice))
        root.update_idletasks()
        root.destroy()
        print("sigann GUI OK")
        return 0
    configure_logging()
    root = tk.Tk(className="annName")
    controller = AnalyzerController(RFExplorerDevice)
    app = SigannApp(root, controller)

    def request_close(_signum=None, _frame=None):
        if not app._closing:
            root.after(0, app.close)

    signal.signal(signal.SIGINT, request_close)
    try:
        app.run()
    finally:
        app.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
