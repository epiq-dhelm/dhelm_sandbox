            device.get("ID_VENDOR_ID") == TARGET_VENDOR_ID
            and device.get("ID_MODEL_ID") == TARGET_PRODUCT_ID
        ):
            ports.append(device.device_node)

    if DEBUG:
        print("Candidate CP210x ports:", ports)

    if not ports:
        raise RuntimeError("No RFExplorer devices found")

    for port in ports:
        try:
            if DEBUG:
                print(f"Trying port {port}")

            objRFE.ConnectPort(port, BAUDRATE)

            # Give the device time to respond
            time.sleep(0.5)

            # --- IDENTIFICATION STEP ---
            if objRFE.IsAnalyzer:
                print(f"Attached to RFE Signal Analyzer on {port}")
                root.wm_title('RFE Signal Analyzer ' + port)
                return port

            else:
                if DEBUG:
                    print(f"{port} is not an analyzer, disconnecting")
                objRFE.DisconnectPort()

        except Exception as e:
            if DEBUG:
                print(f"Failed on {port}: {e}")
            try:
                objRFE.DisconnectPort()
            except Exception:
                pass

    raise RuntimeError("No Signal Analyzer found")


# if something goes wrong go here
def cleanup():
    # kill the main window
    root.destroy

    # close RFE
    objRFE.Close()

    # leave
    exit()


def show_connecting_screen():
    for w in current_frame.winfo_children():
        w.destroy()

    label = Label(
        current_frame,
        text="Connecting to RFExplorer Signal Analyzer...\nPlease wait.",
        font=("Arial", 16)
    )
    label.pack(expand=True, pady=40)

    current_frame.pack(fill="both", expand=True)

    # 🔑 Force Tk to draw NOW
    root.update_idletasks()
    root.update()


