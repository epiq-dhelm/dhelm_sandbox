#!/usr/bin/python3
"""Tk control panel for an RF Explorer signal generator."""

from __future__ import annotations

import logging
import signal
import sys
import tkinter as tk
from tkinter import messagebox, ttk

from siggen_core import (
    ConnectionState,
    ControllerEvent,
    CWSettings,
    EventKind,
    GeneratorController,
    POWER_DBM_BY_LEVEL,
    SweepSettings,
)
from siggen_rfexplorer import RFExplorerGenerator


LOG = logging.getLogger("siggen")
POLL_INTERVAL_MS = 100
RECONNECT_INTERVAL_MS = 1000
UI_FONT = ("Arial", 16)
STATUS_FONT = ("Arial", 13)


class SiggenApp:
    """Own the interface and translate controller events into UI updates."""

    def __init__(self, root: tk.Tk, controller: GeneratorController):
        self.root = root
        self.controller = controller
        self._closing = False
        self._poll_id = None
        self._retry_id = None
        self._command_buttons = []

        self.style = ttk.Style(self.root)
        self.style.configure("TLabel", font=UI_FONT)
        self.style.configure("TButton", font=UI_FONT, padding=(10, 6))
        self.style.configure("TNotebook.Tab", font=UI_FONT, padding=(14, 8))
        self.style.configure("Status.TLabel", font=STATUS_FONT)
        self.style.configure(
            "Connection.TLabel",
            font=("Arial", 14, "bold"),
        )

        self.root.title("RFE Signal Generator")
        self.root.geometry("820x540+100+200")
        self.root.minsize(740, 500)
        self.root.protocol("WM_DELETE_WINDOW", self.close)
        self.root.columnconfigure(0, weight=1)
        self.root.rowconfigure(0, weight=1)

        self._build_ui()

    def _build_ui(self) -> None:
        content = ttk.Frame(self.root, padding=12)
        content.grid(row=0, column=0, sticky="nsew")
        content.columnconfigure(0, weight=1)
        content.rowconfigure(1, weight=1)

        header = ttk.Frame(content)
        header.grid(row=0, column=0, sticky="ew", pady=(0, 10))
        header.columnconfigure(0, weight=1)
        self.connection_var = tk.StringVar(value="Starting...")
        ttk.Label(
            header,
            textvariable=self.connection_var,
            style="Connection.TLabel",
        ).grid(row=0, column=0, sticky="w")
        self.output_label = tk.Label(
            header,
            text="RF OUTPUT OFF",
            bg="#d9d9d9",
            fg="black",
            padx=10,
            pady=4,
            font=("Arial", 14, "bold"),
        )
        self.output_label.grid(row=0, column=1, sticky="e")

        notebook = ttk.Notebook(content)
        notebook.grid(row=1, column=0, sticky="nsew")

        cw_frame = ttk.Frame(notebook, padding=16)
        sweep_frame = ttk.Frame(notebook, padding=16)
        notebook.add(cw_frame, text="Continuous Wave")
        notebook.add(sweep_frame, text="Frequency Sweep")
        self._build_cw_panel(cw_frame)
        self._build_sweep_panel(sweep_frame)

        footer = ttk.Frame(content)
        footer.grid(row=2, column=0, sticky="ew", pady=(10, 0))
        footer.columnconfigure(0, weight=1)
        self.detail_var = tk.StringVar(
            value="Searching for an RF Explorer signal generator..."
        )
        ttk.Label(
            footer,
            textvariable=self.detail_var,
            style="Status.TLabel",
        ).grid(
            row=0, column=0, sticky="w"
        )
        ttk.Button(footer, text="Exit", command=self.close).grid(
            row=0, column=1, sticky="e"
        )

        self._set_controls_enabled(False)

    def _build_cw_panel(self, frame: ttk.Frame) -> None:
        frame.columnconfigure(1, weight=1)
        self.cw_frequency_var = tk.StringVar(value="1002.0")
        self.cw_power_var = tk.StringVar(value="0")
        self.cw_power_text = tk.StringVar()

        ttk.Label(frame, text="Frequency (MHz):").grid(
            row=0, column=0, sticky="e", padx=(0, 10), pady=10
        )
        tk.Entry(
            frame,
            textvariable=self.cw_frequency_var,
            width=16,
            font=UI_FONT,
            relief="sunken",
            borderwidth=1,
        ).grid(row=0, column=1, sticky="w", pady=10)

        ttk.Label(frame, text="Power level (0–7):").grid(
            row=1, column=0, sticky="e", padx=(0, 10), pady=10
        )
        tk.Spinbox(
            frame,
            from_=0,
            to=7,
            width=8,
            textvariable=self.cw_power_var,
            font=UI_FONT,
            relief="sunken",
            borderwidth=1,
        ).grid(row=1, column=1, sticky="w", pady=10)
        ttk.Label(frame, textvariable=self.cw_power_text).grid(
            row=1, column=2, sticky="w", padx=(10, 0), pady=10
        )
        self.cw_power_var.trace_add("write", self._update_power_labels)

        controls = ttk.Frame(frame)
        controls.grid(row=2, column=0, columnspan=3, sticky="w", pady=(18, 0))
        start = ttk.Button(controls, text="Power On", command=self.start_cw)
        start.grid(row=0, column=0, padx=(0, 8))
        stop = ttk.Button(controls, text="Power Off", command=self.power_off)
        stop.grid(row=0, column=1)
        self._command_buttons.extend((start, stop))
        self._update_power_labels()

    def _build_sweep_panel(self, frame: ttk.Frame) -> None:
        frame.columnconfigure(1, weight=1)
        self.sweep_vars = {
            "start": tk.StringVar(value="997.0"),
            "power": tk.StringVar(value="0"),
            "steps": tk.StringVar(value="10"),
            "step": tk.StringVar(value="1002"),
            "delay": tk.StringVar(value="1000"),
        }
        fields = (
            ("Start frequency (MHz):", "start"),
            ("Power level (0–7):", "power"),
            ("Number of steps:", "steps"),
            ("Frequency step (kHz):", "step"),
            ("Step time (ms):", "delay"),
        )
        for row, (label, key) in enumerate(fields):
            ttk.Label(frame, text=label).grid(
                row=row, column=0, sticky="e", padx=(0, 10), pady=6
            )
            if key == "power":
                widget = tk.Spinbox(
                    frame,
                    from_=0,
                    to=7,
                    width=8,
                    textvariable=self.sweep_vars[key],
                    font=UI_FONT,
                    relief="sunken",
                    borderwidth=1,
                )
            else:
                widget = tk.Entry(
                    frame,
                    width=16,
                    textvariable=self.sweep_vars[key],
                    font=UI_FONT,
                    relief="sunken",
                    borderwidth=1,
                )
            widget.grid(row=row, column=1, sticky="w", pady=6)

        self.sweep_power_text = tk.StringVar()
        ttk.Label(frame, textvariable=self.sweep_power_text).grid(
            row=1, column=2, sticky="w", padx=(10, 0), pady=6
        )
        self.sweep_stop_text = tk.StringVar(value="Stop frequency: —")
        ttk.Label(frame, textvariable=self.sweep_stop_text).grid(
            row=5, column=0, columnspan=3, sticky="w", pady=(8, 0)
        )
        for variable in self.sweep_vars.values():
            variable.trace_add("write", self._update_sweep_summary)

        controls = ttk.Frame(frame)
        controls.grid(row=6, column=0, columnspan=3, sticky="w", pady=(16, 0))
        start = ttk.Button(controls, text="Start Sweep", command=self.start_sweep)
        start.grid(row=0, column=0, padx=(0, 8))
        stop = ttk.Button(controls, text="Stop Sweep", command=self.power_off)
        stop.grid(row=0, column=1)
        self._command_buttons.extend((start, stop))
        self._update_sweep_summary()

    def start(self) -> None:
        self._begin_connect("Connecting to RF Explorer signal generator...")
        self._schedule_poll()

    def run(self) -> None:
        self.start()
        self.root.mainloop()

    def _schedule_poll(self) -> None:
        if not self._closing:
            self._poll_id = self.root.after(POLL_INTERVAL_MS, self._poll)

    def _poll(self) -> None:
        self._poll_id = None
        if self._closing:
            return

        for event in self.controller.drain_events():
            self._handle_event(event)

        if self.controller.state == ConnectionState.READY:
            try:
                problem = self.controller.connection_problem()
                if problem is not None:
                    self._set_output(False)
                    self._begin_connect(
                        f"Connection lost: {problem}; reconnecting..."
                    )
            except Exception as error:
                LOG.exception("Generator health check failed")
                self._set_output(False)
                self._begin_connect(f"Connection check failed: {error}")

        self._schedule_poll()

    def _handle_event(self, event: ControllerEvent) -> None:
        LOG.info(event.message)
        if event.kind == EventKind.CONNECTED:
            self.connection_var.set(event.message)
            self.detail_var.set(
                "Expansion generator detected"
                if event.info and event.info.expansion_active
                else "Standard generator detected"
            )
            if event.info:
                self.root.title(f"RFE Signal Generator — {event.info.port}")
            self._set_output(False)
            self._set_controls_enabled(True)
            return

        if event.kind == EventKind.COMMAND_SUCCEEDED:
            self.detail_var.set(event.message)
            if event.output_active is not None:
                self._set_output(event.output_active)
            self._set_controls_enabled(True)
            return

        if event.kind == EventKind.FAILED:
            self.connection_var.set("Signal generator disconnected")
            self.detail_var.set(f"{event.message}. Retrying...")
            self.root.title("RFE Signal Generator — disconnected")
            self._set_output(False)
            self._set_controls_enabled(False)
            self._schedule_retry()

    def _begin_connect(self, status: str) -> None:
        if self._closing:
            return
        if self._retry_id is not None:
            self.root.after_cancel(self._retry_id)
            self._retry_id = None
        if self.controller.connect(reason=status.rstrip(".")):
            self.connection_var.set(status)
            self.detail_var.set("Searching available USB devices...")
            self._set_controls_enabled(False)

    def _schedule_retry(self) -> None:
        if self._closing or self._retry_id is not None:
            return
        self._retry_id = self.root.after(RECONNECT_INTERVAL_MS, self._retry_connect)

    def _retry_connect(self) -> None:
        self._retry_id = None
        self._begin_connect("Waiting for RF Explorer signal generator...")

    def _set_controls_enabled(self, enabled: bool) -> None:
        state = "normal" if enabled else "disabled"
        for button in self._command_buttons:
            button.configure(state=state)

    def _set_busy(self, message: str) -> None:
        self.detail_var.set(message)
        self._set_controls_enabled(False)

    def _set_output(self, active: bool) -> None:
        if active:
            self.output_label.configure(
                text="RF OUTPUT ON",
                bg="#c62828",
                fg="white",
            )
        else:
            self.output_label.configure(
                text="RF OUTPUT OFF",
                bg="#d9d9d9",
                fg="black",
            )

    def _update_power_labels(self, *_args) -> None:
        try:
            level = int(self.cw_power_var.get())
            text = f"{POWER_DBM_BY_LEVEL[level]:.1f} dBm nominal"
        except (ValueError, KeyError):
            text = "Invalid power level"
        self.cw_power_text.set(text)

    def _update_sweep_summary(self, *_args) -> None:
        try:
            level = int(self.sweep_vars["power"].get())
            self.sweep_power_text.set(
                f"{POWER_DBM_BY_LEVEL[level]:.1f} dBm nominal"
            )
        except (ValueError, KeyError):
            self.sweep_power_text.set("Invalid power level")
        try:
            settings = self._sweep_settings()
            self.sweep_stop_text.set(
                f"Stop frequency: {settings.stop_mhz:.3f} MHz"
            )
        except ValueError:
            self.sweep_stop_text.set("Stop frequency: —")

    def _sweep_settings(self) -> SweepSettings:
        return SweepSettings.from_strings(
            self.sweep_vars["start"].get(),
            self.sweep_vars["power"].get(),
            self.sweep_vars["steps"].get(),
            self.sweep_vars["step"].get(),
            self.sweep_vars["delay"].get(),
        )

    def start_cw(self) -> None:
        try:
            settings = CWSettings.from_strings(
                self.cw_frequency_var.get(),
                self.cw_power_var.get(),
            )
        except ValueError as error:
            messagebox.showerror("Invalid CW settings", str(error), parent=self.root)
            return
        if self.controller.start_cw(settings):
            self._set_busy("Starting continuous-wave output...")

    def start_sweep(self) -> None:
        try:
            settings = self._sweep_settings()
        except ValueError as error:
            messagebox.showerror(
                "Invalid sweep settings",
                str(error),
                parent=self.root,
            )
            return
        if self.controller.start_sweep(settings):
            self._set_busy("Starting frequency sweep...")

    def power_off(self) -> None:
        if self.controller.power_off():
            self._set_busy("Turning RF output off...")

    def close(self) -> None:
        if self._closing:
            return
        self._closing = True
        self.detail_var.set("Turning RF output off and closing...")
        if self._poll_id is not None:
            self.root.after_cancel(self._poll_id)
            self._poll_id = None
        if self._retry_id is not None:
            self.root.after_cancel(self._retry_id)
            self._retry_id = None
        self.controller.shutdown()
        self.root.destroy()


def configure_logging() -> None:
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(name)s: %(message)s",
    )


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "--check-runtime":
        tk.Tcl().eval("info patchlevel")
        RFExplorerGenerator.candidate_ports()
        print("siggen runtime imports OK")
        return 0
    if len(sys.argv) == 2 and sys.argv[1] == "--check-gui":
        root = tk.Tk(className="genName")
        root.withdraw()
        SiggenApp(root, GeneratorController(RFExplorerGenerator))
        root.update_idletasks()
        root.destroy()
        print("siggen GUI OK")
        return 0
    configure_logging()
    root = tk.Tk(className="genName")
    controller = GeneratorController(RFExplorerGenerator)
    app = SiggenApp(root, controller)

    def request_close(_signum=None, _frame=None):
        if not app._closing:
            root.after(0, app.close)

    signal.signal(signal.SIGINT, request_close)
    try:
        app.run()
    finally:
        app.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
